# Build trees
/build/
/cmake-build-*/

# Per-module object files cached between builds, beside the entry source
.soliton/

# Compiled Soliton programs and intermediate artifacts
*.exe
*.ll
*.o
*.obj
*.pdb

# Packaged editor extensions; these belong on the release page.
*.vsix

# Credentials. Never in the tree, and never in a commit by accident.
*token*.txt
*.pat
