/// A program in four files.
///
/// `import` names a module; a module called `geometry` lives in
/// `geometry.ci` beside the file that imports it. Items are reached
/// through `module::item`, and only `pub` ones are reachable at all.
import geometry;
import counter;

pub fn main() {
    let p = geometry::Point { x: 3, y: 4 };

    print("distance_sq: ");
    println(geometry::distance_sq(p, geometry::ORIGIN));

    print("magnitude_sq: ");
    println(geometry::magnitude_sq(p));

    // `manhattan` calls a private helper inside its own module, which
    // is allowed there and would not be allowed from here.
    print("manhattan: ");
    println(geometry::manhattan(geometry::Point { x: 0 - 3, y: 4 }));

    print("origin.x: ");
    println(geometry::ORIGIN.x);

    // A second module, with its own namespace.
    let c = counter::bumped(counter::bumped(counter::start(), 5), 7);
    print("counter: ");
    println(c.value);
}
