/// Generic functions and structs, monomorphized.
///
/// Soliton has no traits, so a type parameter carries no guarantees and a
/// generic body cannot be checked in the abstract: `a > b` is fine for
/// some `T` and not others. So each instantiation is checked as if it
/// had been written out by hand, and a mistake is reported against the
/// call that demanded it. That is C++'s model rather than Rust's.
///
/// Each instantiation becomes its own function in the binary:
/// `max(3, 7)` and `max(2.5, 1.5)` compile to `max__int` and
/// `max__float`, with no boxing and no dispatch at run time.

/// The larger of two values.
pub fn max<T>(a: T, b: T) -> T {
    if a > b {
        return a;
    }
    return b;
}

/// The smaller of two values.
pub fn min<T>(a: T, b: T) -> T {
    if a < b {
        return a;
    }
    return b;
}

/// Returns its argument. Useful mostly for showing that `T` can be any
/// type at all, including ones with no operators.
pub fn identity<T>(value: T) -> T {
    return value;
}

/// The first element of any array of three. `T` is inferred through the
/// array, so both an `[int; 3]` and a `[float; 3]` work.
pub fn first<T>(values: &[T; 3]) -> T {
    return values[0];
}

/// Two values of the same type, travelling together.
struct Pair<T> {
    pub left: T,
    pub right: T,
}

/// A struct may take more than one parameter.
struct Labelled<K, V> {
    pub key: K,
    pub value: V,
}

pub fn left_of<T>(pair: Pair<T>) -> T {
    return pair.left;
}

pub fn value_of<K, V>(entry: Labelled<K, V>) -> V {
    return entry.value;
}

pub fn main() {
    // One generic function, two instantiations.
    print("max:      ");
    print(max(3, 7));
    print(" ");
    println(max(2.5, 1.5));

    print("min:      ");
    print(min(3, 7));
    print(" ");
    println(min(2.5, 1.5));

    // `T` need not support any operation at all.
    print("identity: ");
    print(identity(42));
    print(" ");
    print(identity(true));
    print(" ");
    println(identity("a string"));

    let ints: [int; 3] = [10, 20, 30];
    let floats: [float; 3] = [1.5, 2.5, 3.5];
    print("first:    ");
    print(first(ints));
    print(" ");
    println(first(floats));

    // Generic structs. The type arguments of a literal are inferred
    // from its field values; in type position they are written out.
    let counts: Pair<int> = Pair { left: 1, right: 2 };
    let ratios: Pair<float> = Pair { left: 0.25, right: 0.75 };

    print("pairs:    ");
    print(left_of(counts));
    print(" ");
    println(left_of(ratios));

    let entry: Labelled<string, int> = Labelled { key: "answer", value: 42 };
    print("labelled: ");
    print(entry.key);
    print(" = ");
    println(value_of(entry));
}
