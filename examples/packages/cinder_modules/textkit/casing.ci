/// Private to the package, in the sense that nothing outside imports it.
///
/// It is found by the ordinary rule — a file beside the one that
/// imported it — which is what lets a package be more than one file.
/// Cinder has no way to seal a module off, so this is a convention rather
/// than a guarantee: see the README's limitations.

pub fn emphatic(text: string) -> String {
    let mut out: String = new_string();
    push_str(out, text);
    push_str(out, "!");
    return out;
}
