/// Internal to the package, and named so: `textkit::casing`.
///
/// Keeping it under the package's own name is what stops it colliding
/// with a `casing` somewhere else in the program. Module names are
/// still global — nesting makes them unambiguous, it does not make them
/// private. Soliton has no way to seal a module off; see the README.

pub fn emphatic(text: string) -> String {
    let mut out: String = new_string();
    push_str(out, text);
    push_str(out, "!");
    return out;
}
