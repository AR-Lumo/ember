/// A `Vec<String>`: a vector whose elements each own heap memory.
///
/// Dropping this vector is not one `free`. It walks the elements that
/// are live, drops each of them, and only then releases the buffer they
/// were sitting in — recursively, so a `Vec<Vec<String>>` unwinds all
/// the way down.
///
/// The ownership rules are the same ones that apply everywhere else in
/// Soliton, and they are what makes this safe with no garbage collector:
///
///   * `push(words, w)` moves `w` into the vector, and `w` is done.
///   * `words[i]` reads an element without taking it. It cannot be
///     moved out, because what remained would be half-owned — the
///     vector would still count an element it no longer holds.
///   * `pop(words)` shortens the vector and hands an element back, so
///     nothing is left half-owned and the caller owns what it gets.

/// Borrows a word rather than taking it, so the caller keeps it.
pub fn width(word: &String) -> int {
    return len(word);
}

/// Builds an owned `String` from a borrowed `string` view.
pub fn make(text: string) -> String {
    let mut out: String = new_string();
    push_str(out, text);
    return out;
}

pub fn main() {
    let mut words: Vec<String> = new_vec();
    push(words, make("soliton"));
    push(words, make("compiles"));
    push(words, make("to native code"));

    print("words:   ");
    println(len(words));

    // Reading an element borrows it: the vector still owns every one.
    let mut letters = 0;
    let mut i = 0;
    while i < len(words) {
        print("  ");
        println(words[i]);
        letters = letters + width(words[i]);
        i = i + 1;
    }
    print("letters: ");
    println(letters);

    // `pop` is how an element's ownership comes back out.
    let last = pop(words);
    print("popped:  ");
    println(last);
    print("left:    ");
    println(len(words));

    // `words` owns two strings and `last` owns a third. All three are
    // freed on the way out of this function, and nothing here says so.
}
